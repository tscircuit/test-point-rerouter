{
  "name": "@tscircuit/test-point-rerouter",
  "version": "0.0.1",
  "description": "Clearance-aware test point placement and bounded local trace rerouting",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/test-point-rerouter"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsup lib/index.ts --format esm --dts",
    "start": "cosmos",
    "build:site": "cosmos-export",
    "prototype": "bun scripts/export-test-point-board.ts"
  },
  "dependencies": {
    "@tscircuit/solver-utils": "0.0.23",
    "graphics-debug": "0.0.99"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-cosmos": "^6.2.3",
    "react-cosmos-plugin-vite": "^6.2.0",
    "vite": "^6.0.11",
    "typescript": "^5.9.3",
    "tsup": "^8.5.0"
  },
  "license": "MIT"
}
