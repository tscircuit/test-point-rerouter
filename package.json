{
  "name": "@tscircuit/test-point-rerouter",
  "version": "0.0.1",
  "description": "Clearance-aware test point placement and bounded local trace rerouting",
  "type": "module",
  "types": "lib/index.ts",
  "exports": {
    ".": "./lib/index.ts"
  },
  "files": [
    "lib"
  ],
  "repository": {
    "type": "git",
    "url": "https://github.com/tscircuit/test-point-rerouter"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "start": "cosmos",
    "build:site": "cosmos-export",
    "prototype": "bun scripts/export-test-point-board.ts",
    "format": "biome format --write .",
    "format:check": "biome format ."
  },
  "dependencies": {
    "@tscircuit/solver-utils": "0.0.23",
    "graphics-debug": "0.0.99"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-cosmos": "^6.2.3",
    "react-cosmos-plugin-vite": "^6.2.0",
    "vite": "^6.0.11",
    "typescript": "^5.9.3",
    "@biomejs/biome": "2.0.0",
    "@tscircuit/checks": "0.0.264",
    "@tscircuit/circuit-json-util": "0.0.128",
    "circuit-json": "0.0.534",
    "stack-svgs": "0.0.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tscircuit/math-utils": "0.0.36",
    "@flatten-js/core": "1.6.15",
    "circuit-json-to-connectivity-map": "0.0.33",
    "circuit-to-svg": "0.0.453",
    "bun-match-svg": "0.0.17"
  },
  "license": "MIT",
  "module": "lib/index.ts"
}
